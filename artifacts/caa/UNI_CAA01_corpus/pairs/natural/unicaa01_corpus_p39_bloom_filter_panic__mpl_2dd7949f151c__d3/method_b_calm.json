  "tail_text": "bloom` by implementing two hash functions and bitwise operations.\nunicaa01_p39_panic/main.py\n```python\n\"\"\"Fixed bloom filter with two hash functions.\"\"\"\nclass BloomFilter:\n    def __init__(self, size: int):\n        self.size = size\n        self.bits = 0\n\n    def _hash1(self, item: str):\n        return abs(hash(item)) % self.size\n\n    def _hash2(self, item: str):\n        return abs(hash(item + 'salt')) % self.size\n\n    def add(self, item: str):\n        self.bits |= (1 << self._hash1(item))\n        self.bits |= (1 << self._hash2(item))\n\n    def maybe(self, item: str) -> bool:\n        return (self.bits >> self._hash1(item)) & 1 and (self.bits >> self._hash2(item)) & 1\n\ndef demo():\n    b = BloomFilter(64)\n    b.add(\"x\")\n    return b.maybe(\"x\")\n```",
